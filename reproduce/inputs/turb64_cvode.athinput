# Athena++, GOW17 with CVODE, on the shared field; the counterpart of
# turb64_si.athinput. The Riemann solver is fixed at configure time, so the
# binary must be built with --flux=hllc; run_turb64.sh checks this.

<comment>
problem   = GOW17 + CVODE on the shared AthenaK field

<job>
problem_id = turb64_cvode

<time>
cfl_number = 0.3
integrator = rk2      # AthenaK default; Athena++ default is vl2
xorder     = 2        # PLM, matches AthenaK reconstruct = plm
nlim       = -1
tlim       = 2.0454   # exactly 2 Myr at 0.9778 Myr per code unit
ncycle_out = 1

<mesh>
nx1        = 64
x1min      = -16.0
x1max      = 16.0
ix1_bc     = periodic
ox1_bc     = periodic

nx2        = 64
x2min      = -16.0
x2max      = 16.0
ix2_bc     = periodic
ox2_bc     = periodic

nx3        = 64
x3min      = -16.0
x3max      = 16.0
ix3_bc     = periodic
ox3_bc     = periodic

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
gamma    = 1.666666666666667
active   = true
sfloor   = 0
dfloor   = 1.0e-1
pfloor   = 1.0e+0

<units>
unit_system = ism

<chemistry>
Zdg        = 1.
xHe        = 0.1
xC         = 1.6e-4
xO         = 3.2e-4
xSi        = 1.7e-6
reltol     = 1.0e-2
abstol     = 1.0e-15
user_jac   = false
maxsteps   = 100000
output_zone_sec = true
maxorder   = 2
stldet     = 0

<chem_radiation>
G0           = 1e-6
CR           = 2e-16
n_frequency  = 8

<problem>
vtkfile       = shared_ic64.vtk
scalars       = density, pressure
vectors       = velocity
is_joined_vtk = 1
r_init        = 1.0e-6

<output1>
file_type = vtk
variable  = prim
dt        = 0.02

<output2>
file_type = hst
dt        = 0.005
